package br.com.senaisp.bauru.secao05.aula11;

import java.util.Random;

public class TicTacToe {
	private char [] tab; //tabuleiro
	private String nomePlayer; 
	private byte [] posDisp;
	private Random rnd;
	//constructor 
	public TicTacToe() {
		tab = new char [9]; //criando o vetor de 9 posições 
		rnd = new Random();
		posDisp = new byte [9];
				
	}
	public String getNomePlayer() {
		return nomePlayer;
	}
	public void setNomePlayer(String nomePlayer) {
		this.nomePlayer = nomePlayer;
	}
	public void iniciarTabuleiro() {
	  for (int i=0; i<9; i++) {
		  tab[i] = '_';
	  }
	  tab[4] = 'X';
	  atualizarPosLivre(4);
	  
	}
	private void atualizarPosLivre(int i) {
		byte[] ap = posDisp; //guardo a referência do vetor
		posDisp = new byte[ap.length - 1]; //crio um novo vetor
		
	}
}
